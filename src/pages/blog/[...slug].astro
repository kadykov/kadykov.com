---
import { getCollection, render } from "astro:content"
import BlogPostLayout from "../../layouts/BlogPostLayout.astro"
import { getReadingTime } from "../../utils/readingTime"

export async function getStaticPaths() {
  const blogEntries = await getCollection(
    "blog",
    ({ data }) => data.draft !== true
  )
  return blogEntries.map((entry) => ({
    params: { slug: entry.id }, // Use entry.id for the parameter
    props: { entry },
  }))
}

const { entry } = Astro.props
// Use the render() function from astro:content - works for both .md and .mdoc files
const { Content } = await render(entry)

// Calculate reading time from the raw content body
const readingTime = getReadingTime(entry.body ?? "")
---

<BlogPostLayout frontmatter={entry.data} readingTime={readingTime}>
  <Content />
</BlogPostLayout>
